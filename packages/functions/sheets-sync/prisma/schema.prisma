generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User OAuth tokens for background sync operations
model UserToken {
  userEmail       String   @id
  encryptedTokens String   // AES-256 encrypted JSON of { access_token, refresh_token, expiry_date }
  updatedAt       DateTime @updatedAt
}
