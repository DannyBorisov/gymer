{
  "name": "gymerr",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev -w @gymerr/frontend",
    "dev:backend": "npm run dev -w @gymerr/backend",
    "build": "npm run build -w @gymerr/shared && npm run build -w @gymerr/backend && npm run build -w @gymerr/frontend",
    "build:frontend": "npm run build -w @gymerr/frontend",
    "build:backend": "npm run build -w @gymerr/backend",
    "ios:deploy":"npm run cap:sync -w @gymerr/frontend"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@vercel/node": "^5.10.1"
  }
}
