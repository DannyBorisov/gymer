generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Goal {
  LOSE_FAT
  BUILD_MUSCLE
  MAINTAIN
  GAIN_STRENGTH
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MuscleGroup {
  ABS
  BACK
  BICEPS
  CHEST
  LEGS
  SHOULDERS
  TRICEPS
}

enum AiGenerationType {
  CreateProgram
  CouchCue
  PlateauAdvice
}

model Onboarding {
  id              String          @id @default(cuid())
  userEmail       String          @unique
  weight          Float
  height          Float
  age             Int
  gender          Gender
  goal            Goal
  experienceLevel ExperienceLevel
  isComplete      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model AiGeneration {
  id        String           @id @default(cuid())
  userEmail String
  type      AiGenerationType
  content   String
  date      DateTime         @default(now())

  @@index([userEmail, date])
}

model Exercise {
  id          String      @id @default(cuid())
  name        String
  muscleGroup MuscleGroup
  variant     String[]    @default([])
}
