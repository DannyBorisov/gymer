generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Goal {
  LOSE_FAT
  BUILD_MUSCLE
  MAINTAIN
  GAIN_STRENGTH
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum MuscleGroup {
  ABS
  BACK
  BICEPS
  CHEST
  LEGS
  SHOULDERS
  TRICEPS
}

enum AiGenerationType {
  CreateProgram
  CouchCue
  PlateauAdvice
}

model Onboarding {
  id              String          @id @default(cuid())
  userEmail       String          @unique
  weight          Float
  height          Float
  age             Int
  gender          Gender
  goal            Goal
  experienceLevel ExperienceLevel
  isComplete      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model AiGeneration {
  id        String           @id @default(cuid())
  userEmail String
  type      AiGenerationType
  content   String
  date      DateTime         @default(now())

  @@index([userEmail, date])
}

model Exercise {
  id          String      @id @default(cuid())
  name        String
  muscleGroup MuscleGroup
  variant     String[]    @default([])
}

// User OAuth tokens for background sync operations (Cloud Function)
model UserToken {
  userEmail       String   @id
  encryptedTokens String   // AES-256 encrypted JSON of { access_token, refresh_token, expiry_date }
  updatedAt       DateTime @updatedAt
}

// Saved workout templates - reusable workout structures from programs
model WorkoutTemplate {
  id        String   @id @default(cuid())
  userEmail String
  name      String   // e.g. "Push Day", "Upper Body"
  exercises Json     // Array of { name, sets, reps, rir }
  createdAt DateTime @default(now())

  @@index([userEmail])
}

// User-created custom exercises
model UserExercise {
  id          String      @id @default(cuid())
  userEmail   String
  name        String
  muscleGroup MuscleGroup
  createdAt   DateTime    @default(now())

  @@unique([userEmail, name])
  @@index([userEmail])
}

// Calendar notes - user notes for specific dates
model CalendarNote {
  id        String   @id @default(cuid())
  userEmail String
  date      String   // YYYY-MM-DD format
  note      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userEmail, date])
  @@index([userEmail])
}
